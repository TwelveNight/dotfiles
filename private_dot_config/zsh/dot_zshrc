# Keep startup usable before optional tools and plugins are installed.
mkdir -p -- "$XDG_CACHE_HOME/zsh" "$XDG_STATE_HOME/zsh"
source "$ZDOTDIR/utils/exports.zsh"

# Install Zap separately; restoring dotfiles does not install plugins.
if [[ -r "${XDG_DATA_HOME:-$HOME/.local/share}/zap/zap.zsh" ]]; then
  source "${XDG_DATA_HOME:-$HOME/.local/share}/zap/zap.zsh"
fi
if (( $+functions[plug] )); then
  plug "zsh-users/zsh-autosuggestions"
  plug "zap-zsh/supercharge"
  plug "zsh-users/zsh-syntax-highlighting"
  plug "zsh-users/zsh-history-substring-search"
  plug "zap-zsh/sudo"
  plug "MichaelAquilina/zsh-you-should-use"
  plug "agkozak/zsh-z"
  plug "zap-zsh/fzf"
  plug "Aloxaf/fzf-tab"
  plug "Freed-Wu/fzf-tab-source"
  export VI_MODE_ESC_INSERT="jk"
  plug "zap-zsh/vim"
  plug "joshskidmore/zsh-fzf-history-search"
  plug "wintermi/zsh-golang"
fi
if (( $+commands[fzf] )); then
  source "$ZDOTDIR/plugins/fzf/fzf.plugin.zsh"
fi
source "$ZDOTDIR/utils/function.zsh"
source "$ZDOTDIR/utils/aliases.zsh"
source "$ZDOTDIR/utils/bindkey.zsh"

autoload -Uz compinit
compinit -d "$XDG_CACHE_HOME/zsh/zcompdump-$ZSH_VERSION"

export GOPATH="$HOME/.local/share/go"
[[ -d "$HOME/.go" ]] && export GOROOT="$HOME/.go"
path=("$GOPATH/bin" $path)
(( $+commands[thefuck] )) && eval "$(thefuck --alias)"
# Explicit success when an optional command is absent.
true
